# DatsDefense Strategy Bot — environment configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Team auth token issued at DatsTeam registration (sent as the X-Auth-Token header).
DATS_TOKEN=your-team-token-here

# Game endpoint. Defaults to the test server if unset.
DATS_BASE_URL=https://games-test.datsteam.dev/play/zombidef
